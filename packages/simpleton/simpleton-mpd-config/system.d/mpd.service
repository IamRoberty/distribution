[Unit]
Description=Simpleton MPD (bit-perfect audio transport)
After=network.target sound.target

[Service]
Type=forking
PIDFile=/storage/.mpd/pid
ExecStartPre=/bin/mkdir -p /storage/music /storage/.mpd/playlists /storage/.config/mpd
ExecStartPre=/bin/sh -c '[ -f /storage/.config/mpd/mpd.conf ] || cp /usr/config/mpd/mpd.conf /storage/.config/mpd/mpd.conf'
# Point MPD at the attached USB DAC by name (never blocks MPD from starting).
ExecStartPre=-/usr/bin/simpleton-dac-detect
# Removable cards/drives are mounted by udevil under /var/media (see
# simpleton-media-mount). One symlink makes them all visible to MPD.
ExecStartPre=/bin/ln -sfn /var/media /storage/music/Cards
ExecStart=/usr/bin/mpd /storage/.config/mpd/mpd.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
