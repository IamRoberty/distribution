[Unit]
Description=Simpleton MPD (bit-perfect audio transport)
After=network.target sound.target

[Service]
Type=forking
PIDFile=/storage/.mpd/pid
ExecStartPre=/bin/mkdir -p /storage/music /storage/.mpd/playlists /storage/.config/mpd
ExecStartPre=/bin/sh -c '[ -f /storage/.config/mpd/mpd.conf ] || cp /usr/config/mpd/mpd.conf /storage/.config/mpd/mpd.conf'
ExecStart=/usr/bin/mpd /storage/.config/mpd/mpd.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
