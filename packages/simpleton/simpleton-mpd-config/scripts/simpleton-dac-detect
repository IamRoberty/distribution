#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Copyright (C) 2026 Simpleton
#
# simpleton-dac-detect: point MPD at the attached USB DAC.
#
# Writes the DAC into mpd.conf by NAME (hw:CARD=<name>,DEV=0) - never by
# card number, which changes from boot to boot. Only touches the
# audio_output "device" line.
#
# Two ways in:
#   (no arguments)      ExecStartPre of mpd.service: the DAC present at
#                       power-on. Leaves mpd.conf alone if the DAC it names
#                       is attached, so a choice the user made is kept.
#   --hotplug [cardN]   from udev, when a USB sound card appears. The card
#                       that just appeared wins (11 Oct 2026: that is what
#                       the user meant by plugging it in), MPD is restarted
#                       when the setting changed, and the restart is
#                       checked - 11 Oct: real plugs left MPD running on the
#                       old DAC while the replayed event worked, so this
#                       waits for the card to settle, says what it did in
#                       the journal, and restarts the hard way if the first
#                       request didn't take.
#
# "Attached" means a USB-Audio line in /proc/asound/cards: a card unplugged
# while MPD holds it open stays as a ghost (its /proc/asound/<name> link
# too) until MPD lets go, and a replug then comes back as "<name>_1".

ASOUND="${SIMPLETON_ASOUND:-/proc/asound}"
CONF="${SIMPLETON_MPD_CONF:-/storage/.config/mpd/mpd.conf}"
SYSTEMCTL="${SIMPLETON_SYSTEMCTL:-systemctl}"

say() { echo "simpleton-dac-detect: $*"; logger -t simpleton-dac-detect "$*" 2>/dev/null; }

[ -f "$CONF" ] || exit 0

current=$(sed -n 's/^[[:space:]]*device[[:space:]]*"\(.*\)".*/\1/p' "$CONF" | head -n 1)

# is a card of this id attached as USB-Audio? (the listing, not a proc link)
attached() {
  grep -q "^ *[0-9]* \[$(printf '%s' "$1" | sed 's/[][\.*^$]/\\&/g') *\]: *USB-Audio" "$ASOUND/cards"
}

# the id of a card by its kernel name ("card2"), "" unless it is a USB card
usb_id_of() {
  [ -r "$ASOUND/$1/id" ] || return 0
  id=$(cat "$ASOUND/$1/id")
  [ -n "$id" ] && attached "$id" && printf '%s' "$id"
}

# the first USB-Audio card's id in the listing
first_usb() {
  awk '/USB-Audio/ { if (match($0, /\[[^]]*\]/)) { s = substr($0, RSTART + 1, RLENGTH - 2); sub(/[ \t]+$/, "", s); print s; exit } }' "$ASOUND/cards"
}

hotplug=0
[ "$1" = "--hotplug" ] && hotplug=1
dac=""

if [ $hotplug = 1 ]; then
  # the card that just appeared, by name - waiting a little for the kernel
  # to finish registering it (the udev event comes early)
  n=0
  while [ $n -lt 8 ]; do
    if [ -n "$2" ]; then dac=$(usb_id_of "$2"); else dac=$(first_usb); fi
    [ -n "$dac" ] && break
    n=$((n + 1))
    sleep 0.5
  done
  [ -n "$dac" ] || dac=$(first_usb)
  [ -n "$dac" ] || { say "hotplug ${2:-?}: no USB sound card attached, nothing to do"; exit 0; }
else
  case "$current" in
    hw:CARD=*)
      name=${current#hw:CARD=}
      name=${name%%,*}
      if attached "$name"; then exit 0; fi          # the configured DAC is attached: keep it
      ;;
  esac
  dac=$(first_usb)
  [ -n "$dac" ] || exit 0                           # no DAC yet: MPD starts with what it has
fi

new="hw:CARD=$dac,DEV=0"
if [ "$new" = "$current" ]; then
  [ $hotplug = 1 ] && say "hotplug ${2:-?}: $dac, already MPD's device"
  exit 0
fi

sed -i "s|^\([[:space:]]*device[[:space:]]*\)\".*\"|\1\"$new\"|" "$CONF"
say "MPD output set to $new (was: ${current:-none})"

[ $hotplug = 1 ] || exit 0

# restart MPD so it reads the new device, and make sure it did
before=$($SYSTEMCTL show mpd.service -p ExecMainStartTimestampMonotonic --value 2>/dev/null)
$SYSTEMCTL try-restart mpd.service
rc=$?
n=0
while [ $n -lt 20 ]; do
  after=$($SYSTEMCTL show mpd.service -p ExecMainStartTimestampMonotonic --value 2>/dev/null)
  [ -n "$after" ] && [ "$after" != "$before" ] && break
  n=$((n + 1))
  sleep 0.5
done
if [ -n "$after" ] && [ "$after" != "$before" ]; then
  say "MPD restarted on $new"
else
  say "MPD did not restart (try-restart rc=$rc) - restarting it the hard way"
  $SYSTEMCTL restart mpd.service
  say "MPD restart: rc=$? ($($SYSTEMCTL is-active mpd.service 2>/dev/null))"
fi
exit 0
