+
+#pragma pack(1)
+
+class ID {
+public:
+	uint8_t ckID[4];
+	bool has_id(const char* id) {
+		return ckID[0] == id[0] && ckID[1] == id[1] && ckID[2] == id[2] && ckID[3] == id[3];
+	}
+	void set_id(const char* id) {
+		ckID[0] = id[0];
+		ckID[1] = id[1];
+		ckID[2] = id[2];
+		ckID[3] = id[3];
+	}
+};
+
+class Chunk : public ID {
+public:
+	uint64_t ckDataSize;
+	uint64_t get_size() {
+		return hton64(ckDataSize);
+	}
+	void set_size(uint64_t size) {
+		ckDataSize = hton64(size);
+	}
+};
