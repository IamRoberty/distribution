+
+typedef struct {
+  uint8_t  zero_1[2];
+  uint8_t  tracks;
+  uint8_t  indexes;
+  uint32_t len_in_pts;
+  uint8_t  zero_2[4];
+  uint16_t track_sector_table_offset;
