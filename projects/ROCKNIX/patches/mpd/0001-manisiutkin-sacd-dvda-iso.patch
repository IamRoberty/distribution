+
+void log_printf(const char* fmt, ...);
+
+namespace dst {
+
+static auto GET_BIT = [](auto base, auto index) {
+	return (((unsigned char*)base)[index >> 3] >> (7 - (index & 7))) & 1;
+};
+
+static auto GET_NIBBLE = [](auto base, auto index) {
