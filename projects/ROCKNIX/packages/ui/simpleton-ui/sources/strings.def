 * Archer Ave. theme's name for it */
STR(HOME_TITLE,          "home.title",          "Home")
STR(HOME_FOLDERS,        "home.folders",        "Folders")
STR(HOME_ALBUMS,         "home.albums",         "Albums")
STR(HOME_ARTISTS,        "home.artists",        "Artists")
STR(HOME_TRACKS,         "home.tracks",         "Tracks")
STR(HOME_RECENT,         "home.recent",         "Recent")
STR(HOME_FAVORITES,      "home.favorites",      "Favorites")
STR(HOME_PLAYLISTS,      "home.playlists",      "Playlists")
STR(HOME_MIXTAPES,       "home.mixtapes",       "Mixtapes")
STR(HOME_COLLECTIONS,    "home.collections",    "Collections")
STR(HOME_VISUALIZATION,  "home.visualization",  "Visualization")
STR(HOME_NOW_PLAYING,    "home.now_playing",    "Now Playing")
STR(HOME_SETTINGS,       "home.settings",       "Settings")
STR(HINT_OPEN,           "hint.open",           "open")
STR(HINT_CHANGE,         "hint.change",         "change")

/* a view the Home page lists before it is built */
STR(VIEW_NOT_YET,        "view.not_yet",        "Not built yet")
STR(VIEW_NOT_YET_TEXT,   "view.not_yet_text",   "This view comes in a later version. Folders, Now Playing and Settings work today.")

