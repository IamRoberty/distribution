# SimpletonOS theme: Archer Ave. (the expanded UI's first theme, Engineering
# Note 05: Wes Anderson palettes + a tape collection). One colourway is picked
# at random per track for the placeholder art (never the same twice in a row).
name Archer Ave.
design cassette
accent D98AA3
font 1 Jost-Medium.ttf caps
font 2 Jost-Bold.ttf caps
font 3 Jost-Medium.ttf mixed
colourway background=5B1A18 shell=F1BB7B label=FD6467 text=5B1A18 ; Grand Budapest
colourway background=CEAB07 shell=D5D5D3 label=F3DF6C text=24281A ; Moonrise 1
colourway background=899DA4 shell=DC863B label=FAEFD1 text=C93312 ; Royal 1
colourway background=798E87 shell=CCC591 label=C27D38 text=29211F ; Moonrise 2
colourway background=02401B shell=A2A475 label=D8B70A text=02401B ; Cavalcanti
colourway background=74A089 shell=F8AFA8 label=FDDDA0 text=9A8822 ; Royal 2
colourway background=7294D4 shell=E6A0C4 label=C6CDF7 text=7294D4 ; Grand Budapest 2
colourway background=85D4E3 shell=F4B5BD label=FAD77B text=9C964A ; Moonrise 3
colourway background=446455 shell=D3DDDC label=FDD262 text=446455 ; Chevalier
colourway background=3B9AB2 shell=78B7C5 label=EBCC2A text=F21A00 ; Zissou
colourway background=46ACC8 shell=DD8D29 label=E2D200 text=B40F20 ; Fantastic Fox
colourway background=5BBCD6 shell=F2AD00 label=00A08A text=FAEFD1 ; Darjeeling
colourway background=35274A shell=EABE94 label=0B775E text=E1BD6D ; Rushmore
uifont Jost-Medium.ttf
# The battery indicator (0.18a, Ian): a 50 px disc top right, the percentage in
# Jost Bold 22 - blue from 50 %, yellow from 10 %, red under, green on the cable;
# black numbers on blue/yellow/green, cream on red (whichever ink reads better).
battery diameter=50 font=Jost-Bold.ttf size=22 high=45ACC8 mid=E3D200 low=B41823 charge=17B436 ink=29221E inklight=FAEFD0

# Artless album tiles in the grid (0.16f, 9 Oct 2026; tilestyle.h).
# Ian's colour sets, one per line: tilepalette <name> <colours...>
tilepalette GP1  F1BB7B FD6467 5B1A17 D67237
tilepalette GP2  E6A0C4 C6CCF8 D8A499 7194D4
tilepalette MR1  F3DF6C CEAC08 D5D5D3 24281B
tilepalette MR2  7A8E88 C27D39 CBC590 29221E
tilepalette MR3  85D4E3 F4B5BE 9C974A CDBF8B FBD77C
tilepalette CHV  456455 FDD263 D3DDDD C7B19C
tilepalette R1   8A9DA4 C93312 FAEFD0 DD863B
tilepalette R2   998721 F5CDB5 F8AEA8 FDDDA0 74A089
tilepalette CVC  D7B707 01401D A2A475 82A88E 982D13
tilepalette FOX  DD8D29 E4D104 45ACC8 E58601 B41820
tilepalette DJ   FF2500 00A089 F3AD01 F88400 5BBBD7
tilepalette ZS   3C9AB2 78B7C6 EBCC2A E0AF00 F22300
#   tilecolours theme     the tape colourways above, as before 0.16f
#   tilecolours palettes  any colour of any set as the tile, its palette
#                         inks from the same set
#   tilecolours mix       any colour as the tile, palette inks from any set
#   tilecolours generate  tile colours invented each visit from the sets'
#                         hues, saturation and lightness, inked as mix
tilecolours palettes
# The least contrast an ink may have (1 = none, 21 = black on white). Low on
# purpose: Archer Ave. is about vibe more than contrast.
tilecontrast 2.0
# The floor for a whole list of text (the track lists, 0.19): a tick above
# the tiles' - a screen of titles needs more than one tile (Ian, 13 Oct).
listcontrast 3.0
# A cream any non-pastel tile may take as its ink.
tilecream FAEFD0
# How often each kind of ink is drawn: a palette colour, the cream, an
# off-black (the sets' darkest colours). A kind that doesn't read on a tile
# gives its share to the others.
tileinks palette=60 cream=25 dark=15
# The smallest a title may be set on a tile, as a fraction of the tile side
# (0.12 = 28 px at 3 across on the handheld); below it the title is trimmed
# with dots instead of shrinking, and a bracketed tail is trimmed or dropped
# first (Ian, 10 Oct).
tiletextmin 0.12
# Cover fonts: the face an album title is set in on a no-art tile (0.16i,
# Ian's type notes of 9 Oct; 10 Oct: Oi, Wendy One and Sigmar One taken out
# for the liner pages instead). Dealt per visit from a deck with share= cards
# of each (default 10, so roughly equal), never the same face as the no-art
# tile to the left or above. Jost Bold caps at 70% leading is the Archer Ave.
# look.
#   coverfont <file> caps|mixed leading=<% of the face's own line spacing>
#             [share=N] [max=<letters>] [min=<fraction of the tile>] [contrast=<ratio>] [long] [big]
#   max:      only titles up to that many letters (wide faces)
#   min:      only when the title fits at that fraction of the tile or bigger (faces that must be large)
#   contrast: only on tiles whose ink reads at that ratio or better
#   long:     first choice for long titles (condensed faces)
#   big:      the size ladder starts a step bigger (a short title fills the tile)
coverfont Jost-Bold.ttf caps leading=70
coverfont Jost-SemiBold.ttf caps leading=70
coverfont Jost-Black.ttf caps leading=70
coverfont Jost-Medium.ttf mixed leading=80
coverfont Jost-Light.ttf mixed leading=80 max=9 big contrast=4.5
coverfont Arvo-Bold.ttf mixed leading=90
coverfont Monoton-Regular.ttf caps leading=100 max=10 big min=0.15 contrast=4.5
coverfont Caprasimo-Regular.ttf mixed leading=100
coverfont AntonSC-Regular.ttf mixed leading=65 long
coverfont BBHHegarty-Regular.ttf caps leading=70 max=8 big min=0.14
coverfont Shrikhand-Regular.ttf mixed leading=80
coverfont Creepster-Regular.ttf mixed leading=80 share=1
coverfont GravitasOne.ttf mixed leading=80 big
coverfont Bevan-Regular.ttf mixed leading=70

# The album page (0.17, 10 Oct 2026; album-page-6b.md, albumpage.h).
#
# Liner fonts: the faces a track list may be set in (Ian's type notes of
# 9 Oct: Jost, Arvo, Caprasimo, Shrikhand, Anton SC, Dekko, Updock for the
# liner). Dealt by share when a layout says liner=any.
#   linerfont <file> caps|mixed [leading=N] [share=N]
linerfont Jost-Medium.ttf mixed leading=100 share=40
linerfont Arvo-Regular.ttf mixed leading=100 share=20
linerfont Caprasimo-Regular.ttf mixed leading=100 share=10
linerfont Shrikhand-Regular.ttf mixed leading=95 share=5
linerfont AntonSC-Regular.ttf mixed leading=85 share=10
# 11 Oct: Dekko and Updock out (Ian: Dekko doesn't sit with the other
# faces, Updock is too small to read); their shares go to Jost Medium.
linerfont Jost-Light.ttf mixed leading=100 share=10

# Page layouts, one drawn per visit for the screen (every one once before
# any repeats). Everything a layout decides is on its line:
#   pagelayout <name> screen=tv|handheld
#       art=left|right|centre           TV: where the cover square goes; centre splits the list
#       sides=none|letters|numbers      the words over a split list: Side A / Side B, Side 1 / Side 2 (Disc 1 / Disc 2 for a 2-disc album)
#       header=artist-big|album-big|centred|none   handheld: which name is big
#       artist=<coverfont>|any  album=<coverfont>|any   the names' faces (their caps and leading from the coverfont line); any = dealt
#       liner=<linerfont>|any           the list face
#       size=S|M|L  leading=N           the list type and its line spacing (default the liner font's)
#       numbers=none|01|1.|1            track numbers, hanging before the titles
#       align=left|centre|right
#       colours=art|paper|tile          from the cover's main colour, its paper (its own white or black), or a tile colourway
pagelayout sleeve-left   screen=tv art=left   liner=Jost-Medium.ttf size=M numbers=01 align=left colours=art
pagelayout sleeve-right  screen=tv art=right  liner=Arvo-Regular.ttf size=M numbers=none align=left colours=art
pagelayout sleeve-dots   screen=tv art=left   liner=any size=M numbers=1. align=left colours=art
pagelayout gatefold      screen=tv art=centre sides=letters artist=Jost-Bold.ttf liner=AntonSC-Regular.ttf size=M leading=85 numbers=none align=centre colours=art
pagelayout gatefold-1-2  screen=tv art=centre sides=numbers artist=Caprasimo-Regular.ttf liner=Jost-Medium.ttf size=S numbers=1 align=left colours=art
pagelayout big-artist    screen=handheld header=artist-big artist=Jost-Bold.ttf album=Jost-Medium.ttf liner=Jost-Medium.ttf size=M numbers=01 align=left colours=art
pagelayout big-album     screen=handheld header=album-big artist=Jost-Medium.ttf album=Bevan-Regular.ttf liner=Arvo-Regular.ttf size=M numbers=none align=left colours=art
pagelayout centred       screen=handheld header=centred album=Shrikhand-Regular.ttf artist=Jost-Medium.ttf liner=Caprasimo-Regular.ttf size=M numbers=none align=centre colours=art
pagelayout dealt         screen=handheld header=artist-big artist=any album=any liner=any size=M numbers=1. align=left colours=art

# The Home page: a shelf of cassette spines (Ian, 4-7 Oct 2026; home.h).
# Tiles are 180x1080 PNGs in themes/archer/ with the label left blank; the
# name is written on at run time, so it follows the language setting.
#   tape <entry> <tile> <font> <size in pt at the master, 1 pt = 4/3 px> <upper|lower|title|asis> <ink RRGGBB> [start|centre|end]
home shelf
shelf rest 0.889
shelf pull 0.96
shelf rail 60
shelf shadow 40
shelf back 1A100C
shelf wood-h wood-h.png
shelf wood-v wood-v.png
tape folders        folders.png        Jost-Bold.ttf               72 upper faefd0
tape albums         albums.png         Bevan-Regular.ttf           64 title 982d13
tape artists        artists.png        Jost-Bold.ttf               72 upper e6a0c4
tape tracks         tracks.png         Caprasimo-Regular.ttf       72 title 5b1a17
tape recent         recent.png         SigmarOne-Regular.ttf       72 upper faefd0
tape favorites      favorites.png      Jost-Bold.ttf               72 upper faefd0
tape mixtapes       mixtapes.png       PermanentMarker-Regular.ttf 72 upper 322823
tape collections    collections.png    Arvo-Bold.ttf               60 title 322823
tape visualization  visualization.png  Caprasimo-Regular.ttf       64 lower e6a0c4
tape nowplaying     mixtapes.png       Shrikhand-Regular.ttf       60 title 982d13
tape settings       settings.png       BBHHegarty-Regular.ttf      68 upper c93312
