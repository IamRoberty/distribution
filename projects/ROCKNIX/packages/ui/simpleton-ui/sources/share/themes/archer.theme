# SimpletonOS theme: Archer Ave. (the expanded UI's first theme, Engineering
# Note 05: Wes Anderson palettes + a tape collection). One colourway is picked
# at random per track for the placeholder art (never the same twice in a row).
name Archer Ave.
design cassette
accent D98AA3
font 1 Jost-Medium.ttf caps
font 2 Jost-Bold.ttf caps
font 3 Jost-Medium.ttf mixed
colourway background=5B1A18 shell=F1BB7B label=FD6467 text=5B1A18 ; Grand Budapest
colourway background=CEAB07 shell=D5D5D3 label=F3DF6C text=24281A ; Moonrise 1
colourway background=899DA4 shell=DC863B label=FAEFD1 text=C93312 ; Royal 1
colourway background=798E87 shell=CCC591 label=C27D38 text=29211F ; Moonrise 2
colourway background=02401B shell=A2A475 label=D8B70A text=02401B ; Cavalcanti
colourway background=74A089 shell=F8AFA8 label=FDDDA0 text=9A8822 ; Royal 2
colourway background=7294D4 shell=E6A0C4 label=C6CDF7 text=7294D4 ; Grand Budapest 2
colourway background=85D4E3 shell=F4B5BD label=FAD77B text=9C964A ; Moonrise 3
colourway background=446455 shell=D3DDDC label=FDD262 text=446455 ; Chevalier
colourway background=3B9AB2 shell=78B7C5 label=EBCC2A text=F21A00 ; Zissou
colourway background=46ACC8 shell=DD8D29 label=E2D200 text=B40F20 ; Fantastic Fox
colourway background=5BBCD6 shell=F2AD00 label=00A08A text=FAEFD1 ; Darjeeling
colourway background=35274A shell=EABE94 label=0B775E text=E1BD6D ; Rushmore
uifont Jost-Medium.ttf

# Artless album tiles in the grid (0.16f, 9 Oct 2026; tilestyle.h).
# Ian's colour sets, one per line: tilepalette <name> <colours...>
tilepalette GP1  F1BB7B FD6467 5B1A17 D67237
tilepalette GP2  E6A0C4 C6CCF8 D8A499 7194D4
tilepalette MR1  F3DF6C CEAC08 D5D5D3 24281B
tilepalette MR2  7A8E88 C27D39 CBC590 29221E
tilepalette MR3  85D4E3 F4B5BE 9C974A CDBF8B FBD77C
tilepalette CHV  456455 FDD263 D3DDDD C7B19C
tilepalette R1   8A9DA4 C93312 FAEFD0 DD863B
tilepalette R2   998721 F5CDB5 F8AEA8 FDDDA0 74A089
tilepalette CVC  D7B707 01401D A2A475 82A88E 982D13
tilepalette FOX  DD8D29 E4D104 45ACC8 E58601 B41820
tilepalette DJ   FF2500 00A089 F3AD01 F88400 5BBBD7
tilepalette ZS   3C9AB2 78B7C6 EBCC2A E0AF00 F22300
#   tilecolours theme     the tape colourways above, as before 0.16f
#   tilecolours palettes  any colour of any set as the tile, its palette
#                         inks from the same set
#   tilecolours mix       any colour as the tile, palette inks from any set
#   tilecolours generate  tile colours invented each visit from the sets'
#                         hues, saturation and lightness, inked as mix
tilecolours palettes
# The least contrast an ink may have (1 = none, 21 = black on white). Low on
# purpose: Archer Ave. is about vibe more than contrast.
tilecontrast 2.0
# A cream any non-pastel tile may take as its ink.
tilecream FAEFD0
# How often each kind of ink is drawn: a palette colour, the cream, an
# off-black (the sets' darkest colours). A kind that doesn't read on a tile
# gives its share to the others.
tileinks palette=60 cream=25 dark=15

# The Home page: a shelf of cassette spines (Ian, 4-7 Oct 2026; home.h).
# Tiles are 180x1080 PNGs in themes/archer/ with the label left blank; the
# name is written on at run time, so it follows the language setting.
#   tape <entry> <tile> <font> <size in pt at the master, 1 pt = 4/3 px> <upper|lower|title|asis> <ink RRGGBB> [start|centre|end]
home shelf
shelf rest 0.889
shelf pull 0.96
shelf rail 60
shelf shadow 40
shelf back 1A100C
shelf wood-h wood-h.png
shelf wood-v wood-v.png
tape folders        folders.png        Jost-Bold.ttf               72 upper faefd0
tape albums         albums.png         Bevan-Regular.ttf           64 title 982d13
tape artists        artists.png        Jost-Bold.ttf               72 upper e6a0c4
tape tracks         tracks.png         Caprasimo-Regular.ttf       72 title 5b1a17
tape recent         recent.png         SigmarOne-Regular.ttf       72 upper faefd0
tape favorites      favorites.png      Jost-Bold.ttf               72 upper faefd0
tape mixtapes       mixtapes.png       PermanentMarker-Regular.ttf 72 upper 322823
tape collections    collections.png    Arvo-Bold.ttf               60 title 322823
tape visualization  visualization.png  Caprasimo-Regular.ttf       64 lower e6a0c4
tape nowplaying     mixtapes.png       Shrikhand-Regular.ttf       60 title 982d13
tape settings       settings.png       BBHHegarty-Regular.ttf      68 upper c93312
